# Plantilla local. Copie a .env y ajuste. Nunca ponga secretos reales aquí.
APP_VERSION=dev
DATABASE_URL=postgres://cne_app:cambiar@localhost:5432/cne
DATABASE_OWNER_URL=postgres://cne_owner:cambiar@localhost:5432/cne
DATABASE_TEST_URL=postgres://cne_owner:cambiar@localhost:5432/cne_test
# Generar con: openssl rand -base64 32
APP_MASTER_KEY=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD_INICIAL=
HOST_CONSULAR=cne.localhost
HOST_DGSMH=dgsmh.localhost
HOST_MADRID=madrid.localhost
HOST_ADMIN=control.localhost
# Envíos reales apagados por defecto (simulado).
WHATSAPP_REAL_SEND=false
EMAIL_REAL_SEND=false
EVOLUTION_INSTANCE=
EVOLUTION_API_URL=http://evolution-api:8080
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
