# Plantilla local. Copie a .env y ajuste. Nunca ponga secretos reales aquí.
APP_VERSION=dev
DATABASE_URL=postgres://cne_app:cambiar@localhost:5432/cne
DATABASE_OWNER_URL=postgres://cne_owner:cambiar@localhost:5432/cne
DATABASE_TEST_URL=postgres://cne_owner:cambiar@localhost:5432/cne_test
# Contraseña del rol cne_app en la base de pruebas (se crea sola).
CNE_APP_TEST_PASSWORD=cambiar
# Generar con: openssl rand -base64 32
APP_MASTER_KEY=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD_INICIAL=
# Host público; la aplicación no depende de su valor.
HOST_MADRID=localhost
# Solo producción (los genera scripts/deploy-oracle.sh).
POSTGRES_PASSWORD=cambiar
CNE_APP_PASSWORD=cambiar
COOKIE_SECURE=0
